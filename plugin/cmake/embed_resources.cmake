# embed_resources.cmake -- write the web editor's files into one C++ source (#105), run at build time:
#
#   cmake -DROOT=<dir> -DOUT=<file.cpp> -DFILES=<a;b;...> -P embed_resources.cmake
#
# FILES are paths relative to ROOT. Each becomes a mapvs::ui::Resource (map_webui.h) at URL path "/<file>", served to
# the page from memory through choc's fetchResource. The table ends with a null path.
foreach(_v ROOT OUT FILES)
    if(NOT DEFINED ${_v})
        message(FATAL_ERROR "embed_resources.cmake: ${_v} not set")
    endif()
endforeach()

set(_src "// generated by plugin/cmake/embed_resources.cmake from plugin/ui/; do not edit\n")
string(APPEND _src "#include \"map_webui.h\"\nnamespace mapvs::ui {\nnamespace {\n")
set(_table "")
set(_i 0)
foreach(_f IN LISTS FILES)
    get_filename_component(_ext "${_f}" LAST_EXT)
    string(TOLOWER "${_ext}" _ext)
    if(_ext STREQUAL ".html")
        set(_mime "text/html")
    elseif(_ext STREQUAL ".css")
        set(_mime "text/css")
    elseif(_ext STREQUAL ".js")
        set(_mime "text/javascript")
    elseif(_ext STREQUAL ".svg")
        set(_mime "image/svg+xml")
    elseif(_ext STREQUAL ".jpg" OR _ext STREQUAL ".jpeg")
        set(_mime "image/jpeg")
    elseif(_ext STREQUAL ".png")
        set(_mime "image/png")
    elseif(_ext STREQUAL ".json")
        set(_mime "application/json")
    else()
        message(FATAL_ERROR "embed_resources.cmake: no MIME type for ${_f}")
    endif()
    file(READ "${ROOT}/${_f}" _hex HEX)
    string(LENGTH "${_hex}" _n)
    math(EXPR _bytes "${_n} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _arr "${_hex}")
    # break the initialiser into lines of 32 bytes
    string(REGEX REPLACE "((0x..,){32})" "\\1\n" _arr "${_arr}")
    string(APPEND _src "const unsigned char r${_i}[] = {\n${_arr}0};\n")
    string(APPEND _table "    {\"/${_f}\", \"${_mime}\", r${_i}, ${_bytes}},\n")
    math(EXPR _i "${_i} + 1")
endforeach()
string(APPEND _src "}  // namespace\nconst Resource kResources[] = {\n${_table}    {nullptr, nullptr, nullptr, 0},\n};\n}\n")

# rewrite only when the content changed, so an unchanged page does not relink the plugins
if(EXISTS "${OUT}")
    file(READ "${OUT}" _old)
    if(_old STREQUAL _src)
        return()
    endif()
endif()
file(WRITE "${OUT}" "${_src}")
